---
import Default from "@layouts/Default.astro";

import { useTranslations, type UiLang } from "@i18n/utils";
import { ui } from "@i18n/ui";

const lang = (Astro.currentLocale || "en") as UiLang;
const t = useTranslations(lang);

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(ui).map((locale) => ({ params: { locale } }));
}

const sections = ["stack", "content", "styling", "deployment"];
---

<Default title={t("howMade.title")} description={t("howMade.description")}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <section class="mb-8">
      <h1 class="text-4xl font-bold text-base-content">{t("howMade.title")}</h1>
      <p class="mt-4 text-lg text-base-content/75">{t("howMade.description")}</p>
    </section>

    <section class="grid gap-4 md:grid-cols-2">
      {
        sections.map((section) => (
          <article class="rounded-box bg-base-100 p-6 shadow-sm">
            <h2 class="text-xl font-semibold text-base-content">{t(`howMade.sections.${section}.title`)}</h2>
            <p class="mt-3 text-base leading-relaxed text-base-content/75">{t(`howMade.sections.${section}.body`)}</p>
          </article>
        ))
      }
    </section>
  </main>
</Default>
