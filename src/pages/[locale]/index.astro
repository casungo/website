---
import Default from "@layouts/Default.astro";
import Projects from "@layouts/Projects.astro";

import Card from "@components/Card.astro";
import Socials from "@components/Socials.astro";
import CardProjects from "@components/CardProjects.astro";

import NowPlaying from "@components/NowPlaying.svelte";

import Fedora33 from "@images/Fedora 33 wallpaper.jpg";
import Briefmaker from "@images/briefmaker.png";
import OsservaprezziCarburantiHa from "@images/osservaprezzi-carburanti-ha.jpg";
import RelationSync from "@images/relation-sync.png";
import Sedbot from "@images/sedbot.jpg";
import BeRealImg from "@images/bereal.png";
import Excel2MdImg from "@images/excel2md.png";
import P7mReaderImg from "@images/p7mreader.png";
import SplitMediaImg from "@images/splitmedia.png";

import { useTranslations, type UiLang } from "@i18n/utils";

import { ui, defaultLang } from "@i18n/ui";

const lang = (Astro.currentLocale || defaultLang) as UiLang;
const t = useTranslations(lang);
const translations = ui[lang];
const defaultTranslations = ui[defaultLang];

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(ui).map((locale) => ({ params: { locale } }));
}
---

<Default title="Pagina iniziale">
  <!-- <Alert client:load /> -->
  <Card title={t("intro.title")} desc={t("intro.desc")} />
  <Card title={t("contact.title")}>
    <div class="text-center">
      <Socials />
    </div>
  </Card>
  <Projects title={t("projects.title")}>
    <CardProjects
      img={OsservaprezziCarburantiHa}
      title={t("projects.cards.osservaprezziCarburantiHa.title")}
      desc={t("projects.cards.osservaprezziCarburantiHa.desc")}
      btnLink="https://github.com/casungo/osservaprezzi-carburanti-ha"
      btnText={t("projects.cards.osservaprezziCarburantiHa.btnText")}
      btnIcon="bxl:github"
    />
    <CardProjects
      img={BeRealImg}
      title={t("apps.cards.bereal.title")}
      desc={t("apps.cards.bereal.desc")}
      btnLink="https://berealgdprviewer.eu"
      btnText={t("apps.cards.bereal.btnText")}
      btnIcon="material-symbols:open-in-new-rounded"
    />
    <CardProjects
      img={Briefmaker}
      title={t("apps.cards.briefmaker.title")}
      desc={t("apps.cards.briefmaker.desc")}
      btnLink="https://briefmakerapp.com/"
      btnText={t("apps.cards.briefmaker.btnText")}
      btnIcon="material-symbols:image-outline-rounded"
    />
    <CardProjects
      img={Excel2MdImg}
      title={t("apps.cards.excel2md.title")}
      desc={t("apps.cards.excel2md.desc")}
      btnLink="https://exceltomarkdown.app"
      btnText={t("apps.cards.excel2md.btnText")}
      btnIcon="material-symbols:table-chart-outline"
    />
    <CardProjects
      img={P7mReaderImg}
      title={t("apps.cards.p7mreader.title")}
      desc={t("apps.cards.p7mreader.desc")}
      btnLink="https://p7mreader.eu"
      btnText={t("apps.cards.p7mreader.btnText")}
      btnIcon="material-symbols:open-in-new-rounded"
    />
    <CardProjects
      img={SplitMediaImg}
      title={t("apps.cards.splitmedia.title")}
      desc={t("apps.cards.splitmedia.desc")}
      btnLink="https://splityourmedia.top"
      btnText={t("apps.cards.splitmedia.btnText")}
      btnIcon="material-symbols:call-split"
    />
    <CardProjects img={Sedbot} title={t("projects.cards.sedbot.title")} desc={t("projects.cards.sedbot.desc")} btnLink="https://github.com/casungo/sedbot" btnText={t("projects.cards.sedbot.btnText")} btnIcon="bxl:github" />
    <CardProjects
      img={RelationSync}
      title={t("projects.cards.relationSync.title")}
      desc={t("projects.cards.relationSync.desc")}
      btnLink="https://github.com/casungo/relation-sync-plugin"
      btnText={t("projects.cards.relationSync.btnText")}
      btnIcon="bxl:github"
    />
    <CardProjects
      img={Fedora33}
      title={t("projects.cards.fedora33.title")}
      desc={t("projects.cards.fedora33.desc")}
      btnLink="https://pagure.io/design/issue/raw/files/219f997ff4aa506ea4ec4b3f82d380f32e2411027f3d62f8d8b059d55ed3c3b3-dawn.png"
      btnText={t("projects.cards.fedora33.btnText")}
      btnIcon="material-symbols:image-outline-rounded"
    />
  </Projects>
</Default>
<NowPlaying client:idle {translations} {defaultTranslations} />
